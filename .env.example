# Interruptor de las consultas salientes al INE.
# En false la API solo hace validacion local (util para desarrollo).
CONSULTA_INE_HABILITADA=true

# Origen publico del INE
INE_BASE_URL=https://listanominal.ine.mx/scpln/
INE_TIMEOUT=30

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=["*"]
